generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Medicine {
  id                      Int      @id @default(autoincrement())
  sourceNo                Int      @unique
  name                    String   @db.VarChar(180)
  category                String   @db.VarChar(120)
  indication              String   @db.Text
  usageDescription        String   @db.Text
  age                     String   @db.VarChar(100)
  forbiddenDiseaseHistory String   @db.Text
  price                   Int?
  imageUrl                String?  @db.VarChar(255)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@map("medicines")
}

model RecommendationHistory {
  id              Int      @id @default(autoincrement())
  patientName     String?  @db.VarChar(120)
  age             Int?
  complaint       String   @db.Text
  duration        String?  @db.VarChar(120)
  diseaseHistory  String?  @db.Text
  topMedicineName String?  @db.VarChar(180)
  topSimilarity   Float?
  resultSnapshot  String   @db.LongText
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("recommendation_histories")
}
